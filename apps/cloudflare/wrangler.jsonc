// pi-cloud on Cloudflare: one Worker, the control plane as one Durable Object, one Durable Object per session.
//   pnpm --filter @pi-cloud/cloudflare exec wrangler secret put PI_CLOUD_API_KEYS   (and PI_CLOUD_CREDENTIAL_KEY, ANTHROPIC_API_KEY, ...)
//   pnpm --filter @pi-cloud/cloudflare run deploy
{
  "name": "pi-cloud",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL_PLANE", "class_name": "ControlPlane" },
      { "name": "SESSION_HOST", "class_name": "SessionHost" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ControlPlane", "SessionHost"] }],
  "observability": { "enabled": true }
}
