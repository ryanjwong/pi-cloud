{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./scripts/oxlint-no-comments.js"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "pi-cloud/no-comments": "error",
    "vitest/no-conditional-expect": "off",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "until",
          "fc.assert"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.wrangler/**",
    "**/.data/**"
  ]
}
