{
  "name": "pi-cloud",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@effect/platform-node": "4.0.2",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fast-check": "4.10.2",
    "oxlint": "1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "2.9.1"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 exec tsc -p . && tsc -p scripts",
    "test": "pnpm -r --if-present test",
    "start": "pnpm --filter @pi-cloud/local start",
    "cli": "node packages/cli/src/main.ts",
    "deploy:cloudflare": "node apps/cloudflare/scripts/deploy.ts",
    "lint": "oxlint && node scripts/lint-files.ts"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.28.0"
  }
}
